rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function isMember(cid) {
      return signed() && request.auth.uid in get(/databases/$(database)/documents/couples/$(cid)).data.members;
    }

    // cada pessoa guarda só o ponteiro para o casal dela
    match /users/{uid} {
      allow read, write: if signed() && request.auth.uid == uid;
    }

    // convites: só quem tem o código consegue ler (get); não dá para listar
    match /invites/{code} {
      allow get: if signed();
      allow list: if false;
      allow create: if signed()
        && request.resource.data.by == request.auth.uid
        && isMember(request.resource.data.cid);
      allow delete: if signed();
    }

    match /couples/{cid} {
      allow create: if signed() && request.resource.data.members == [request.auth.uid];
      allow read: if signed() && request.auth.uid in resource.data.members;
      allow update: if signed() && (
        request.auth.uid in resource.data.members
        || (
          // entrar com convite válido: só pode acrescentar a si mesmo como segundo membro
          resource.data.members.size() == 1
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'invite'])
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.invite))
          && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.cid == cid
          && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.exp > request.time.toMillis()
        )
      );

      match /{sub=**} {
        allow read, write: if isMember(cid);
      }
    }
  }
}
